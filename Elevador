<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Elevador de Silla de Ruedas</title>
<style>
:root{--bg:#eceff1;--ink:#1f2b30;--muted:#66767d;--panel:rgba(255,255,255,.92);--line:#d3dcdf;--accent:#c2410c}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){--bg:#11171a;--ink:#e3eaec;--muted:#93a3a9;--panel:rgba(26,34,38,.92);--line:#2c383d;--accent:#f08a4b;color-scheme:dark}}
:root[data-theme="dark"]{--bg:#11171a;--ink:#e3eaec;--muted:#93a3a9;--panel:rgba(26,34,38,.92);--line:#2c383d;--accent:#f08a4b;color-scheme:dark}
html,body{margin:0;height:100%;background:var(--bg);color:var(--ink);font-family:"Segoe UI",Arial,sans-serif;overflow:hidden}
#view{position:fixed;inset:0}
.bar{position:fixed;top:calc(14px + env(safe-area-inset-top,0px));left:14px;right:14px;display:flex;flex-wrap:wrap;gap:8px;align-items:center}
.bar a,.bar button{font:inherit;font-size:13px;padding:8px 12px;border-radius:8px;background:var(--panel);border:1px solid var(--line);color:var(--ink);text-decoration:none;cursor:pointer}
.bar button.on{background:var(--accent);border-color:var(--accent);color:#fff}
.bar h1{font-size:15px;font-weight:600;margin:0 6px 0 4px}
#status{position:fixed;bottom:calc(14px + env(safe-area-inset-bottom,0px));left:50%;transform:translateX(-50%);font-size:12px;color:var(--muted);white-space:nowrap}
:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
</style>
</head>
<body>
<div id="view"></div>
<div class="bar">
  <a href="index.html">&larr; Portafolio</a>
  <h1>Elevador de silla de ruedas</h1>
  <button id="lift" type="button">Simular elevación</button>
  <button id="spin" type="button" class="on">Giro automático</button>
</div>
<div id="status">Cargando piezas…</div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>
<script>
// Piezas exportadas de Elevador.iam (Inventor), en coordenadas del ensamble, mm.
// move: true = sube y baja con la tuerca del husillo.
const PARTS = [
  { f: 'Tornillo_1.stl',          c: '#8f9ba3', metal: .8 },
  { f: 'Tuerca_2.stl',            c: '#b08d57', metal: .7, move: true },
  { f: 'Carro_3.stl',             c: '#3f6e8c', move: true },
  { f: 'Base_4.stl',              c: '#c2410c', move: true },
  { f: 'PlacaSoporte_5.stl',      c: '#5d6b73' },
  { f: 'GuiaVertical_6.stl',      c: '#9aa7ae', metal: .6 },
  { f: 'GuiaVertical_7.stl',      c: '#9aa7ae', metal: .6 },
  { f: 'PlacaSoporteArriba_8.stl',c: '#5d6b73' },
  { f: 'Acople_9.stl',            c: '#d4a017', metal: .5 },
  { f: 'Pared_10.stl',            c: '#cfd8dc', glass: true },
  { f: 'Pared_11.stl',            c: '#cfd8dc', glass: true },
  { f: 'ChasisSuelo_12.stl',      c: '#78909c' },
  { f: 'ChasisTecho_13.stl',      c: '#cfd8dc', glass: true },
];
const css = getComputedStyle(document.documentElement);
const renderer = new THREE.WebGLRenderer({ antialias: true });
renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
renderer.setSize(innerWidth, innerHeight);
renderer.outputEncoding = THREE.sRGBEncoding;
renderer.setClearColor(new THREE.Color(css.getPropertyValue('--bg').trim() || '#eceff1'));
document.getElementById('view').appendChild(renderer.domElement);
const scene = new THREE.Scene();
const camera = new THREE.PerspectiveCamera(35, innerWidth / innerHeight, 1, 50000);
const controls = new THREE.OrbitControls(camera, renderer.domElement);
controls.enableDamping = true; controls.autoRotate = true; controls.autoRotateSpeed = 0.8;
scene.add(new THREE.HemisphereLight(0xffffff, 0x7d8a90, 0.85));
const key = new THREE.DirectionalLight(0xfff2e0, 1.0); key.position.set(3000, 4000, 2500); scene.add(key);
const rim = new THREE.DirectionalLight(0xcfe3ff, 0.5); rim.position.set(-3000, 1500, -2500); scene.add(rim);

// El ensamble tiene +Y hacia abajo: se voltea para que el techo quede arriba.
const model = new THREE.Group(); model.rotation.x = Math.PI; scene.add(model);
const moving = new THREE.Group(); model.add(moving);
const status = document.getElementById('status');
// modelo.json: por pieza, vértices int16 en base64 con su mínimo y escala por eje
function decode(part) {
  const bin = atob(part.data), bytes = new Uint8Array(bin.length);
  for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
  const q = new Int16Array(bytes.buffer), v = new Float32Array(q.length);
  for (let i = 0; i < q.length; i++) { const a = i % 3; v[i] = (q[i] + 32768) * part.scale[a] + part.min[a]; }
  const geo = new THREE.BufferGeometry(); geo.setAttribute('position', new THREE.BufferAttribute(v, 3)); geo.computeVertexNormals(); return geo;
}
fetch('elevador/modelo.json').then(r => { if (!r.ok) throw r.status; return r.json(); }).then(data => {
  PARTS.forEach(p => {
    const m = new THREE.Mesh(decode(data[p.f]), new THREE.MeshStandardMaterial({
      color: new THREE.Color(p.c).convertSRGBToLinear(), metalness: p.metal || .1, roughness: p.metal ? .35 : .6,
      transparent: !!p.glass, opacity: p.glass ? .28 : 1, side: THREE.DoubleSide, depthWrite: !p.glass }));
    (p.move ? moving : model).add(m);
  });
  ready();
}).catch(() => { status.textContent = 'No se pudo cargar el modelo. Recarga la página.'; });

let travel = 0;
function ready() {
  status.textContent = 'Arrastra para girar · rueda o pellizco para acercar';
  model.updateMatrixWorld(true);
  const b = new THREE.Box3().setFromObject(model), c = b.getCenter(new THREE.Vector3()), s = b.getSize(new THREE.Vector3());
  const r = s.length() / 2, dist = r / Math.sin(THREE.MathUtils.degToRad(camera.fov / 2)) * (camera.aspect < 1 ? 1.25 / camera.aspect : 1.05);
  controls.target.copy(c); camera.position.copy(c).add(new THREE.Vector3(1, .45, 1.1).normalize().multiplyScalar(dist)); controls.update();
  // Recorrido de la tuerca por el husillo: parte arriba (y 84–141 mm) y baja hasta cerca de la placa inferior (1219 mm)
  travel = 1219 - 141 - 20;
}
let lifting = false, t0 = 0;
document.getElementById('lift').addEventListener('click', e => { lifting = !lifting; e.target.classList.toggle('on', lifting); t0 = performance.now(); });
document.getElementById('spin').addEventListener('click', e => { controls.autoRotate = !controls.autoRotate; e.target.classList.toggle('on', controls.autoRotate); });
controls.addEventListener('start', () => { controls.autoRotate = false; document.getElementById('spin').classList.remove('on'); });
addEventListener('resize', () => { camera.aspect = innerWidth / innerHeight; camera.updateProjectionMatrix(); renderer.setSize(innerWidth, innerHeight); });
const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
if (reduce) { controls.autoRotate = false; document.getElementById('spin').classList.remove('on'); }
(function loop(now) {
  requestAnimationFrame(loop);
  if (lifting) { const k = (1 - Math.cos((now - t0) / 2600)) / 2; moving.position.y = k * travel; }
  else moving.position.y += (0 - moving.position.y) * .08;
  controls.update(); renderer.render(scene, camera);
})(0);
</script>
</body>
</html>
