    box(.63,.7,.13,metal);cyl(.24,.24,.25,c,0,0,.13,Math.PI/2);cyl(.2,.2,.27,metal,0,0,.16,Math.PI/2);screw(-.24,.25,.08);screw(.24,-.25,.08);
  }else{
    // Mixed source categories (gas equipment, pumps/tanks) keep neutral housings.
    box(.9,.94,.38,c);box(.79,.83,.045,'#d0d9d7',0,0,.215);box(.49,.36,.022,dark,0,.07,.248);
    box(.37,.19,.025,t.group==='mod'?'#507e67':'#7c9898',0,.07,.265);
    for(let i=0;i<5;i++)box(.09,.075,.07,'#98ac83',-.25+i*.125,-.3,.26);
    for(let i=0;i<3;i++)sphere(.023,i===0?green:'#c6d3cf',-.24+i*.11,.33,.255);
    screw(-.34,.33,.252);screw(.34,-.33,.252);
  }
  const positions=[],normals=[],colors=[];
  for(const p of parts){const pos=p.geo.attributes.position.array,n=p.geo.attributes.normal.array;for(let i=0;i<pos.length;i++)positions.push(pos[i]);for(let i=0;i<n.length;i++)normals.push(n[i]);for(let i=0;i<pos.length/3;i++)colors.push(p.color.r,p.color.g,p.color.b);p.geo.dispose();}
  const g=new THREE.BufferGeometry();g.setAttribute('position',new THREE.Float32BufferAttribute(positions,3));g.setAttribute('normal',new THREE.Float32BufferAttribute(normals,3));g.setAttribute('color',new THREE.Float32BufferAttribute(colors,3));g.computeBoundingSphere();return g;
}

const offY = li => L[li].story * EXPLODE;
const groups = L.map((lv, li) => { const g = new THREE.Group(); g.position.y = offY(li); scene.add(g); return g; });
const medianDet = L.map((lv, li) => {
  const z = DV.filter(d => d[4] === li && T[d[3]].group === 'det').map(d => d[2]).sort((a, b) => a - b);
  return z.length ? z[Math.floor(z.length / 2)] : lv.fz + 3;
});

// Slabs
const box = new THREE.Box3();
L.forEach((lv, li) => {
  const cells = new Set(lv.foot.map(c => c.join(','))), pos = [], norm = [], edges = [];
  const face = (a, b, c, d, n) => { for (const p of [a, b, c, a, c, d]) { pos.push(...p); norm.push(...n); } };
  for (const [ix, iz] of lv.foot) {
    const x = ix * CELL, z = -(iz + 1) * CELL, y = lv.fz - .04, b = y - .38;
    const A = [x, y, z], B = [x + CELL, y, z], C = [x + CELL, y, z + CELL], Dd = [x, y, z + CELL];
    const a = [x, b, z], bb = [x + CELL, b, z], c = [x + CELL, b, z + CELL], d = [x, b, z + CELL];
    face(A, Dd, C, B, [0, 1, 0]); face(a, bb, c, d, [0, -1, 0]);
    if (!cells.has([ix, iz + 1].join(','))) { face(A, B, bb, a, [0, 0, -1]); edges.push(...A, ...B); }
    if (!cells.has([ix + 1, iz].join(','))) { face(B, C, c, bb, [1, 0, 0]); edges.push(...B, ...C); }
    if (!cells.has([ix, iz - 1].join(','))) { face(C, Dd, d, c, [0, 0, 1]); edges.push(...C, ...Dd); }
    if (!cells.has([ix - 1, iz].join(','))) { face(Dd, A, a, d, [-1, 0, 0]); edges.push(...Dd, ...A); }
    box.expandByPoint(new THREE.Vector3(x, lv.fz + offY(li), z));
    box.expandByPoint(new THREE.Vector3(x + CELL, lv.fz + offY(li) + 4, z + CELL));
  }
  const geo = new THREE.BufferGeometry();
  geo.setAttribute('position', new THREE.Float32BufferAttribute(pos, 3));
  geo.setAttribute('normal', new THREE.Float32BufferAttribute(norm, 3));
  const mat = new THREE.MeshStandardMaterial({ color: new THREE.Color(lv.color).lerp(new THREE.Color('#afc0bc'), .62).convertSRGBToLinear(), transparent: true, opacity: .7, roughness: .94, side: THREE.DoubleSide, depthWrite: false });
  const m = new THREE.Mesh(geo, mat); groups[li].add(m);
  const eg = new THREE.BufferGeometry(); eg.setAttribute('position', new THREE.Float32BufferAttribute(edges, 3));
  m.add(new THREE.LineSegments(eg, new THREE.LineBasicMaterial({ color: '#607e84', transparent: true, opacity: .45 })));
});

// Equipment
const geoms = T.map(equipmentGeometry);
const mat = new THREE.MeshStandardMaterial({ vertexColors: true, roughness: .47, metalness: .18 });
const o = new THREE.Object3D();
L.forEach((lv, li) => T.forEach((t, ti) => {
  const list = DV.filter(d => d[4] === li && d[3] === ti); if (!list.length) return;
  const m = new THREE.InstancedMesh(geoms[ti], mat, list.length);
  list.forEach((d, k) => { o.position.set(d[0], d[2], -d[1]); o.scale.setScalar(t.size * 1.4); o.updateMatrix(); m.setMatrixAt(k, o.matrix); });
  m.frustumCulled = false; groups[li].add(m);
}));

// Loops (cable runs)
function cable(pts, color) {
  const pairs = []; for (let i = 1; i < pts.length; i++) if (pts[i].distanceToSquared(pts[i - 1]) > .0001) pairs.push([pts[i - 1], pts[i]]);
  const m = new THREE.InstancedMesh(new THREE.CylinderGeometry(.035, .035, 1, 6), new THREE.MeshStandardMaterial({ color, roughness: .38, metalness: .25 }), pairs.length);
  const up = new THREE.Vector3(0, 1, 0);
  pairs.forEach(([a, b], i) => { const d = b.clone().sub(a); o.position.copy(a).add(b).multiplyScalar(.5); o.quaternion.setFromUnitVectors(up, d.clone().normalize()); o.scale.set(1, d.length(), 1); o.updateMatrix(); m.setMatrixAt(i, o.matrix); });
  o.quaternion.identity(); m.frustumCulled = false; return m;
}
DATA.loops.forEach((lp, k) => {
  const li = lp.level, ceil = medianDet[li] + .25, r = DATA.risers[String(L[li].tower)];
  const pts = [new THREE.Vector3(r[0], ceil, -r[1])]; let py = r[1];
  lp.pts.forEach(di => { const d = DV[di]; pts.push(new THREE.Vector3(d[0], ceil, -py), new THREE.Vector3(d[0], ceil, -d[1])); py = d[1]; });
  const c = new THREE.Color(PANEL_COL[lp.panel]); const h = {}; c.getHSL(h); c.setHSL(h.h + (k % 4) * .025 - .035, h.s, Math.min(.62, h.l + (k % 3) * .08 - .05));
  groups[li].add(cable(pts, c));
});

// Frame the camera
const center = box.getCenter(new THREE.Vector3()), size = box.getSize(new THREE.Vector3());
function frame() {
  const dir = new THREE.Vector3(1, .72, 1.32).normalize();
  const r = size.length() / 2, dist = r / Math.sin(THREE.MathUtils.degToRad(camera.fov / 2)) * (camera.aspect < 1 ? 1.35 / camera.aspect : .9);
  controls.target.copy(center); camera.position.copy(center).addScaledVector(dir, dist); controls.update();
}
frame();
addEventListener('resize', () => { camera.aspect = innerWidth / innerHeight; camera.updateProjectionMatrix(); renderer.setSize(innerWidth, innerHeight); frame(); });
(function loop() { requestAnimationFrame(loop); controls.update(); renderer.render(scene, camera); })();
</script>
</body>
